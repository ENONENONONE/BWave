# BWave — ESP32-C6 Brain/Sleep CSI Sensor
CONFIG_IDF_TARGET="esp32c6"

# Flash
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# WiFi
CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WIFI_TX_STATS=n
CONFIG_ESP_WIFI_ENABLE_WIFI_RX_STATS=n

# Bluetooth — NimBLE identity beacon + scanner
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Power management OFF for reliable CSI
CONFIG_PM_ENABLE=n

# Temperature sensor
CONFIG_SOC_TEMP_SENSOR_SUPPORTED=y

# SPI RAM not available on C6
CONFIG_SPIRAM=n

# Increase main task stack
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# SNTP
CONFIG_LWIP_SNTP_MAX_SERVERS=1

# IP forwarding + NAT for SLIP gateway
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y

# BWave network — no credentials or site addresses here.
# Provision SSID / password / target IP per device via NVS (see README.md)
# or a local, uncommitted sdkconfig.
CONFIG_BWAVE_TARGET_PORT=5005
CONFIG_BWAVE_NODE_ID=0
CONFIG_BWAVE_WIFI_CHANNEL=6
CONFIG_BWAVE_EDGE_TIER=2
CONFIG_BWAVE_VITAL_INTERVAL_MS=1000
